"""Types for the private PyO3 extension."""

from typing import final

class SolidCoreError(RuntimeError): ...

@final
class Shape:
    """An opaque B-rep shape; construct with solidfunc's functions."""

    def __add__(self, other: Shape, /) -> Shape: ...
    def __sub__(self, other: Shape, /) -> Shape | None: ...

def _box(
    origin: tuple[float, float, float], size: tuple[float, float, float]
) -> Shape: ...
def _cylinder(
    origin: tuple[float, float, float], radius: float, height: float
) -> Shape: ...
def _union(left: Shape, right: Shape) -> Shape: ...
def _intersection(left: Shape, right: Shape) -> Shape | None: ...
def _difference(left: Shape, right: Shape) -> Shape | None: ...
def _volume(shape: Shape, relative_accuracy: float) -> float: ...
def _translate(shape: Shape, offset: tuple[float, float, float]) -> Shape: ...
def _bounds(shape: Shape) -> tuple[list[float], list[float]]: ...
def _step_text(shape: Shape, file_name: str, name: str) -> str: ...
