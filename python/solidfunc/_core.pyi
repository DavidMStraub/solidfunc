"""Types for the private PyO3 extension."""

from typing import TypeAlias, final

from ._kinds import EdgeKind, FaceKind

_Point3D: TypeAlias = tuple[float, float, float]
_Frame: TypeAlias = tuple[_Point3D, _Point3D, _Point3D]

class KernelError(RuntimeError): ...
class EmptyResultError(ValueError): ...

@final
class Shape:
    """An opaque B-rep shape; construct with solidfunc's functions."""

    def __add__(self, other: Shape, /) -> Shape: ...
    def __sub__(self, other: Shape, /) -> Shape: ...
    def __and__(self, other: Shape, /) -> Shape: ...

@final
class Curve2D:
    """A directed XY curve with endpoints in millimetres."""

    @property
    def start(self) -> tuple[float, float]: ...
    @property
    def end(self) -> tuple[float, float]: ...

@final
class Path2D:
    """An ordered chain of connected XY curves."""

    @property
    def curves(self) -> tuple[Curve2D, ...]: ...
    @property
    def is_closed(self) -> bool: ...

@final
class Profile:
    """An opaque planar region constructed by solidfunc."""

def _box(
    origin: tuple[float, float, float], size: tuple[float, float, float]
) -> Shape: ...
def _cylinder(
    origin: tuple[float, float, float], radius: float, height: float
) -> Shape: ...
def _union(left: Shape, right: Shape) -> Shape: ...
def _union_all(shapes: list[Shape]) -> Shape: ...
def _intersection(left: Shape, right: Shape) -> Shape | None: ...
def _difference(left: Shape, right: Shape) -> Shape | None: ...
def _volume(shape: Shape, relative_accuracy: float) -> float: ...
def _translate(shape: Shape, offset: tuple[float, float, float]) -> Shape: ...
def _rotate(
    shape: Shape,
    origin: tuple[float, float, float],
    axis: tuple[float, float, float],
    angle: float,
) -> Shape: ...
def _line(start: tuple[float, float], end: tuple[float, float]) -> Curve2D: ...
def _arc(
    center: tuple[float, float], radius: float, start: float, sweep: float
) -> Curve2D: ...
def _path(curves: list[Curve2D]) -> Path2D: ...
def _profile(outer: Path2D, holes: list[Path2D]) -> Profile: ...
def _extrude(profile: Profile, distance: float, plane: _Frame) -> Shape: ...

@final
class Path3D:
    @property
    def is_closed(self) -> bool: ...
    def point_at(self, parameter: float) -> _Point3D: ...
    def tangent_at(self, parameter: float) -> _Point3D: ...

def _revolve(
    profile: Profile, plane: _Frame, origin: _Point3D, axis: _Point3D, angle: float
) -> Shape: ...
def _loft(sections: list[tuple[Profile, _Frame]], degree: int) -> Shape: ...
def _loft_paths(paths: list[Path3D], degree: int) -> Shape: ...
def _polyline3d(points: list[_Point3D]) -> Path3D: ...
def _spline(points: list[_Point3D], degree: int) -> Path3D: ...
def _sweep(profile: Profile, plane: _Frame, path: Path3D) -> Shape: ...
def _mirror(shape: Shape, origin: _Point3D, normal: _Point3D) -> Shape: ...
def _place(
    shape: Shape, origin: _Point3D, x: _Point3D, y: _Point3D, z: _Point3D
) -> Shape: ...
def _bounds(shape: Shape) -> tuple[list[float], list[float]]: ...
def _step_text(shape: Shape, file_name: str, name: str) -> str: ...

@final
class Edge:
    @property
    def kind(self) -> EdgeKind: ...
    @property
    def start(self) -> _Point3D: ...
    @property
    def end(self) -> _Point3D: ...
    @property
    def line_direction(self) -> _Point3D | None: ...
    @property
    def circle_center(self) -> _Point3D | None: ...
    @property
    def circle_radius(self) -> float | None: ...
    @property
    def length(self) -> float: ...

@final
class Face:
    @property
    def kind(self) -> FaceKind: ...
    @property
    def area(self) -> float: ...
    @property
    def centroid(self) -> _Point3D: ...
    @property
    def planar_normal(self) -> _Point3D | None: ...

@final
class Vertex:
    @property
    def point(self) -> _Point3D: ...

def _edges(shape: Shape) -> tuple[Edge, ...]: ...
def _face_edges(face: Face) -> tuple[Edge, ...]: ...
def _faces(shape: Shape) -> tuple[Face, ...]: ...
def _edge_faces(edge: Edge) -> tuple[Face, ...]: ...
def _vertices(shape: Shape) -> tuple[Vertex, ...]: ...
def _face_vertices(face: Face) -> tuple[Vertex, ...]: ...
def _edge_vertices(edge: Edge) -> tuple[Vertex, ...]: ...
def _chamfer(shape: Shape, edges: list[Edge], distance: float) -> Shape: ...
def _fillet(shape: Shape, edges: list[Edge], radius: float) -> Shape: ...
def _import_step(text: str) -> Shape: ...
def _tessellate(
    shape: Shape, chord_tolerance: float | None
) -> tuple[
    list[_Point3D], list[_Point3D], list[tuple[int, int, int]], list[list[_Point3D]]
]: ...
