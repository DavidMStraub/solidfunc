"""Types for the private PyO3 extension."""

from typing import final

class SolidCoreError(RuntimeError): ...

@final
class Solid:
    """Opaque geometry; construct with solidfunc's functions."""

def _box(
    origin: tuple[float, float, float], size: tuple[float, float, float]
) -> Solid: ...
def _cylinder(
    origin: tuple[float, float, float], radius: float, height: float
) -> Solid: ...
def _union(left: Solid, right: Solid) -> Solid: ...
def _intersection(left: Solid, right: Solid) -> Solid | None: ...
def _difference(left: Solid, right: Solid) -> Solid | None: ...
def _volume(solid: Solid, relative_accuracy: float) -> float: ...
def _translate(solid: Solid, offset: tuple[float, float, float]) -> Solid: ...
def _bounds(solid: Solid) -> tuple[list[float], list[float]]: ...
def _step_text(solid: Solid, file_name: str, name: str) -> str: ...
